{
  "name": "slsea-solar-generation-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SLSEA solar generation coursework API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
